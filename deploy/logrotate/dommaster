# DomMaster CRM / bot / health logs
# Install: /etc/logrotate.d/dommaster
# copytruncate — процессы пишут через systemd StandardOutput=append

/root/AI_Bot_avto_KP/logs/*.log {
    su root root
    weekly
    rotate 8
    size 20M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 root root
    dateext
    dateformat -%Y%m%d
    maxage 60
}
