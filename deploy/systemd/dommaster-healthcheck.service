[Unit]
Description=Дом-Мастер health-check (CRM / bot / proxy / Telegram)
After=network-online.target dommaster-crm.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/AI_Bot_avto_KP
EnvironmentFile=-/root/AI_Bot_avto_KP/.env
EnvironmentFile=-/root/AI_Bot_avto_KP/web_app/.env
Environment=PYTHONUNBUFFERED=1
Environment=CRM_URL=http://127.0.0.1:5001
# --alert шлёт FAIL только если задан HEALTH_ALERT_CHAT_ID (не в чат менеджера ОП)
ExecStart=/bin/bash /root/AI_Bot_avto_KP/scripts/health_check.sh --alert
Nice=10

[Install]
WantedBy=multi-user.target
