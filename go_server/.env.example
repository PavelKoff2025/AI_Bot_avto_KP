GO_SERVER_HOST=127.0.0.1
GO_SERVER_PORT=5001

# Токен API (тот же, что FLASK_API_TOKEN в корневом .env).
# Без токена API доступен только с localhost.
# FLASK_API_TOKEN=
# API_TOKEN=

# Корень Python-проекта (по умолчанию — родитель go_server/)
# PROJECT_ROOT=/absolute/path/to/AI_Auogeneration

# Python с установленными зависимостями проекта
# PYTHON_BIN=/absolute/path/to/AI_Auogeneration/.venv/bin/python

# BRIDGE_SCRIPT=/absolute/path/to/AI_Auogeneration/go_server/bridge/generate.py
